# Copy to .env — every setting is optional.

# Google News editions to follow (ISO codes). Available: us gb in ca au ie nz sg za ng ke pk ph my ae de fr es it br mx jp kr
FREENEWS_COUNTRIES=us,gb,in,au,ca
# Google Trends regions for /v1/trends
FREENEWS_TREND_GEOS=US,GB,IN
# Include the 50+ direct publisher RSS feeds (BBC, NYT, Guardian, NPR, DW, ...)
FREENEWS_PUBLISHER_FEEDS=true
# Comma-separated source ids to switch off (see /v1/sources)
FREENEWS_DISABLED_SOURCES=
# JSON file with extra sources: [{"id": "...", "name": "...", "url": "...", "category": "world", "country": "us"}]
FREENEWS_EXTRA_SOURCES=

FREENEWS_REFRESH_MINUTES=15
FREENEWS_RETENTION_HOURS=48
FREENEWS_TRENDING_WINDOW_HOURS=24
FREENEWS_HALF_LIFE_HOURS=8

# Protect a public server (comma-separated keys); empty = open
FREENEWS_API_KEYS=
# Requests per minute per key / IP; 0 = unlimited
FREENEWS_RATE_LIMIT=0
FREENEWS_PROXIES=
FREENEWS_CORS_ORIGINS=*
